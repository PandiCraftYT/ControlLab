<Window x:Class="ControlLab.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/ControlLab.ico"
        Title="ControlLab"
        Width="1250"
        Height="800"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ========================================== -->
        <!-- COLORES -->
        <!-- ========================================== -->

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#111821"/>

        <SolidColorBrush x:Key="PanelBorderBrush"
                         Color="#202B37"/>

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#F4F7FB"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#93A4B8"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#66778A"/>


        <!-- ========================================== -->
        <!-- BOTÓN -->
        <!-- ========================================== -->

        <Style x:Key="HeaderButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#8EA1B6"/>

            <Setter Property="Background"
                    Value="#121B24"/>

            <Setter Property="BorderBrush"
                    Value="#263645"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1A2632"/>

                    <Setter Property="BorderBrush"
                            Value="#385067"/>

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================== -->
        <!-- SCROLLBAR -->
        <!-- ========================================== -->

        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="8"/>

            <Setter Property="Background"
                    Value="Transparent"/>

        </Style>

    </Window.Resources>


    <!-- ============================================== -->
    <!-- ESTRUCTURA PRINCIPAL -->
    <!-- ============================================== -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="86"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="58"/>

        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <Border
            Grid.Row="0"
            Background="#11161E"
            BorderBrush="#202B37"
            BorderThickness="0,0,0,1">

            <Grid Margin="30,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- MARCA -->

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- ICONO -->

                    <Border
                        Width="46"
                        Height="46"
                        Background="#132131"
                        BorderBrush="#233B50"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,14,0">

                        <Grid>

                            <Border
                                Width="25"
                                Height="19"
                                BorderBrush="#55A9FF"
                                BorderThickness="2"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,7,0,0"/>

                            <Rectangle
                                Width="2"
                                Height="6"
                                Fill="#55A9FF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,25,0,0"/>

                            <Rectangle
                                Width="15"
                                Height="2"
                                Fill="#55A9FF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,5"/>

                        </Grid>

                    </Border>


                    <StackPanel
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="CONTROL LAB"
                            FontSize="23"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"/>

                        <TextBlock
                            Text="Administración del laboratorio"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Margin="0,2,0,0"/>

                    </StackPanel>

                </StackPanel>


                <!-- SERVIDOR -->

                <Border
                    Grid.Column="1"
                    Background="#10251D"
                    BorderBrush="#1C5940"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="13,7"
                    VerticalAlignment="Center">

                    <StackPanel
                        Orientation="Horizontal">

                        <Ellipse
                            Width="9"
                            Height="9"
                            Fill="#32D583"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>

                        <TextBlock
                            Text="Servidor conectado"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#6FE3AA"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ========================================== -->
        <!-- CONTENIDO -->
        <!-- ========================================== -->

        <Grid
            Grid.Row="1"
            Margin="30,24,30,20">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ====================================== -->
            <!-- TÍTULO -->
            <!-- ====================================== -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock
                        Text="Equipos del laboratorio"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock
                        Text="Supervisa y administra los equipos conectados al sistema."
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Margin="0,5,0,0"/>

                </StackPanel>


                <!-- INDICADOR -->

                <Border
                    Grid.Column="1"
                    Background="#111A23"
                    BorderBrush="#263746"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,8"
                    VerticalAlignment="Center">

                    <StackPanel
                        Orientation="Horizontal">

                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="#55A9FF"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Text="Monitoreo activo"
                            FontSize="11"
                            Foreground="#9FB7CF"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ====================================== -->
            <!-- TARJETAS DE RESUMEN -->
            <!-- ====================================== -->

            <Grid
                Grid.Row="1"
                Margin="0,0,0,22">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- TOTAL -->

                <Border
                    Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Height="112"
                    Margin="0,0,7,0"
                    Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="50"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Border
                            Width="46"
                            Height="46"
                            Background="#16212C"
                            CornerRadius="10"
                            VerticalAlignment="Top">

                            <TextBlock
                                Text="💻"
                                FontSize="23"
                                Foreground="#55A9FF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,0,0">

                            <TextBlock
                                Text="EQUIPOS REGISTRADOS"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}"/>

                            <TextBlock
                                x:Name="TotalEquiposText"
                                Text="0"
                                FontSize="29"
                                FontWeight="Bold"
                                Foreground="White"
                                Margin="0,4,0,0"/>

                            <TextBlock
                                Text="Equipos en el sistema"
                                FontSize="9"
                                Foreground="{StaticResource MutedTextBrush}"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ONLINE -->

                <Border
                    Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#1D4B39"
                    BorderThickness="1"
                    CornerRadius="12"
                    Height="112"
                    Margin="7,0"
                    Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="50"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Border
                            Width="46"
                            Height="46"
                            Background="#10291F"
                            CornerRadius="10"
                            VerticalAlignment="Top">

                            <TextBlock
                                Text="●"
                                FontSize="22"
                                Foreground="#32D583"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,0,0">

                            <TextBlock
                                Text="EN LÍNEA"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#70B897"/>

                            <TextBlock
                                x:Name="EquiposOnlineText"
                                Text="0"
                                FontSize="29"
                                FontWeight="Bold"
                                Foreground="#32D583"
                                Margin="0,4,0,0"/>

                            <TextBlock
                                Text="Conectados actualmente"
                                FontSize="9"
                                Foreground="#527966"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- OFFLINE -->

                <Border
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#4A292D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Height="112"
                    Margin="7,0,0,0"
                    Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="50"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Border
                            Width="46"
                            Height="46"
                            Background="#29171A"
                            CornerRadius="10"
                            VerticalAlignment="Top">

                            <TextBlock
                                Text="●"
                                FontSize="22"
                                Foreground="#F97066"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,0,0">

                            <TextBlock
                                Text="DESCONECTADOS"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#C17A74"/>

                            <TextBlock
                                x:Name="EquiposOfflineText"
                                Text="0"
                                FontSize="29"
                                FontWeight="Bold"
                                Foreground="#F97066"
                                Margin="0,4,0,0"/>

                            <TextBlock
                                Text="Sin conexión con el Manager"
                                FontSize="9"
                                Foreground="#815552"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>


            <!-- ====================================== -->
            <!-- LISTA DE EQUIPOS -->
            <!-- ====================================== -->

            <Border
                Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="13"
                Padding="18">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="1"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ENCABEZADO DE LISTA -->

                    <Grid
                        Grid.Row="0"
                        Margin="2,0,2,15">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel
                            Orientation="Horizontal">

                            <TextBlock
                                Text="▦"
                                FontSize="20"
                                Foreground="#55A9FF"
                                VerticalAlignment="Center"/>

                            <StackPanel
                                Margin="10,0,0,0">

                                <TextBlock
                                    Text="Equipos registrados"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                                <TextBlock
                                    Text="Selecciona un equipo para ver sus detalles."
                                    FontSize="10"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Margin="0,2,0,0"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- ESTADO -->

                        <Border
                            Grid.Column="1"
                            Background="#121C25"
                            BorderBrush="#263645"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="10,6"
                            VerticalAlignment="Center">

                            <StackPanel
                                Orientation="Horizontal">

                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="#32D583"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="Actualización automática"
                                    FontSize="9"
                                    Foreground="#8FA5BA"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- SEPARADOR -->

                    <Border
                        Grid.Row="1"
                        Background="#202B37"/>


                    <!-- SCROLL -->

                    <ScrollViewer
                        Grid.Row="2"
                        Margin="2,16,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <WrapPanel
                            x:Name="AgentsPanel"/>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================== -->
        <!-- FOOTER -->
        <!-- ========================================== -->

        <Border
            Grid.Row="2"
            Background="#11161E"
            BorderBrush="#202B37"
            BorderThickness="0,1,0,0">

            <Grid Margin="30,0">

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="CONTROL LAB"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#65788D"/>

                    <TextBlock
                        Text="  •  Administración del laboratorio"
                        FontSize="10"
                        Foreground="#526273"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <TextBlock
                    x:Name="FooterEquiposText"
                    Text="0 equipos registrados"
                    FontSize="10"
                    Foreground="#65788D"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>