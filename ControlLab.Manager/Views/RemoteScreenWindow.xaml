<Window x:Class="ControlLab.Manager.Views.RemoteScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlLab — Pantalla remota"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C10">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition
                Height="*" />

            <RowDefinition
                Height="Auto" />

        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#0A0C10">

            <Image
                x:Name="RemoteImage"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        </Border>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Text="● Conectando..."
            Foreground="#32D583"
            FontSize="12"
            Margin="15,10"
            HorizontalAlignment="Left" />

    </Grid>

</Window>