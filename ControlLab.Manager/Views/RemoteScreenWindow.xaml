<Window x:Class="ControlLab.Manager.Views.RemoteScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlLab — Pantalla remota"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D12"
        Foreground="#E8EAED"
        WindowStyle="SingleBorderWindow">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <Border Grid.Row="0"
                Background="#11141B"
                BorderBrush="#20242D"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- INFORMACIÓN PC -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🖥"
                                   FontSize="20"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="MachineNameText"
                                   Text="PC"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock Text="Pantalla remota"
                               Foreground="#858B98"
                               FontSize="11"
                               Margin="31,2,0,0"/>

                </StackPanel>

                <!-- ESTADO -->

                <Border Grid.Column="1"
                        Background="#19392C"
                        CornerRadius="8"
                        Padding="12,7"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock x:Name="LiveIndicator"
                                   Text="●"
                                   Foreground="#32D583"
                                   FontSize="11"
                                   Margin="0,0,6,0"/>

                        <TextBlock x:Name="StatusText"
                                   Text="CONECTANDO..."
                                   Foreground="#32D583"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ========================================== -->
        <!-- PANTALLA -->
        <!-- ========================================== -->

        <Border Grid.Row="1"
                Background="#080A0E"
                Margin="14"
                CornerRadius="10"
                BorderBrush="#1C2028"
                BorderThickness="1">

            <Grid>

                <Image x:Name="RemoteImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <!-- MENSAJE CUANDO NO HAY FRAME -->

                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Visible">

                    <TextBlock Text="●"
                               Foreground="#32D583"
                               FontSize="26"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Conectando con el equipo..."
                               Foreground="#A5AAB5"
                               FontSize="14"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ========================================== -->
        <!-- FOOTER -->
        <!-- ========================================== -->

        <Border Grid.Row="2"
                Background="#11141B"
                BorderBrush="#20242D"
                BorderThickness="0,1,0,0">

            <Grid Margin="16,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ESTADO -->

                <TextBlock x:Name="ConnectionText"
                           Grid.Column="0"
                           Text="Conectando..."
                           Foreground="#858B98"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- RESOLUCIÓN -->

                <TextBlock x:Name="ResolutionText"
                           Grid.Column="1"
                           Text="—"
                           Foreground="#858B98"
                           FontSize="11"
                           Margin="20,0"
                           VerticalAlignment="Center"/>

                <!-- FPS -->

                <TextBlock x:Name="FpsText"
                           Grid.Column="2"
                           Text="— FPS"
                           Foreground="#858B98"
                           FontSize="11"
                           Margin="20,0"
                           VerticalAlignment="Center"/>

                <!-- DETENER -->

                <Button x:Name="StopButton"
                        Grid.Column="3"
                        Content="■  Detener"
                        Padding="14,6"
                        Margin="20,0,0,0"
                        Background="#1B1F27"
                        Foreground="#E8EAED"
                        BorderBrush="#2B303A"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="StopButton_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>