<Window x:Class="ControlLab.Manager.Views.AgentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/ControlLab.Manager;component/Assets/ControlLab.ico"
        Title="ControlLab · Detalles del equipo"
        Width="900"
        Height="760"
        MinWidth="900"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ========================================== -->
        <!-- COLORES -->
        <!-- ========================================== -->

        <SolidColorBrush x:Key="PanelBrush" Color="#111821"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#202B37"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0D141C"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A4B8"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#66778A"/>

        <!-- ========================================== -->
        <!-- BOTÓN BASE -->
        <!-- ========================================== -->

        <Style x:Key="BaseButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="#EAF0F7"/>

            <Setter Property="Background"
                    Value="#17212C"/>

            <Setter Property="BorderBrush"
                    Value="#2A3948"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">

                            <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1E2B39"/>

                    <Setter Property="BorderBrush"
                            Value="#3B5268"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#263747"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.38"/>

                    <Setter Property="Cursor"
                            Value="Arrow"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================== -->
        <!-- BOTÓN DE ACCIÓN -->
        <!-- ========================================== -->

        <Style x:Key="ActionButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButton}">

            <Setter Property="Height"
                    Value="82"/>

            <Setter Property="Padding"
                    Value="16"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================================== -->
        <!-- INPUT -->
        <!-- ========================================== -->

        <Style x:Key="DarkTextBox"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="{StaticResource InputBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#293847"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================================== -->
        <!-- ETIQUETAS -->
        <!-- ========================================== -->

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>

            <Setter Property="FontSize"
                    Value="11"/>

        </Style>

    </Window.Resources>


    <!-- ============================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ============================================== -->

    <Grid Margin="18">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- ENCABEZADO -->
        <!-- ========================================== -->

        <Grid Grid.Row="0"
              Margin="10,4,10,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- ICONO DEL EQUIPO -->

            <Border
                Width="72"
                Height="72"
                Background="#132131"
                BorderBrush="#233B50"
                BorderThickness="1"
                CornerRadius="14"
                Grid.Column="0">

                <TextBlock
                    Text="💻"
                    FontSize="42"
                    Foreground="#55A9FF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>


            <!-- NOMBRE Y ESTADO -->

            <StackPanel
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center">

                <StackPanel
                    Orientation="Horizontal">

                    <TextBlock
                        x:Name="MachineIdText"
                        Text="PC-01"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="560"/>

                </StackPanel>


                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,7,0,0">

                    <Border
                        Background="#153B2C"
                        CornerRadius="16"
                        Padding="12,6"
                        Margin="0,0,8,0">

                        <TextBlock
                            x:Name="StatusText"
                            Text="●  En línea"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#32D583"/>

                    </Border>


                    <Border
                        x:Name="AuthorizationBadge"
                        Background="#153B2C"
                        CornerRadius="16"
                        Padding="12,6">

                        <TextBlock
                            x:Name="AuthorizationText"
                            Text="✓  Equipo autorizado"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#32D583"/>

                    </Border>

                </StackPanel>

            </StackPanel>


            <!-- HEARTBEAT -->

            <Border
                Grid.Column="2"
                Width="185"
                Height="60"
                Background="#121D28"
                BorderBrush="#243544"
                BorderThickness="1"
                CornerRadius="30"
                Padding="14">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="34"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock
                        Text="〽"
                        FontSize="26"
                        Foreground="#55C7FF"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>


                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">

                        <TextBlock
                            Text="Último heartbeat"
                            FontSize="10"
                            Foreground="#7F91A5"/>

                        <TextBlock
                            x:Name="HeartbeatText"
                            Text="Sin conexión"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Margin="0,3,0,0"
                            TextTrimming="CharacterEllipsis"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================== -->
        <!-- CONTENIDO -->
        <!-- ========================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.05*"/>

                <ColumnDefinition Width="1.2*"/>

            </Grid.ColumnDefinitions>


            <!-- ====================================== -->
            <!-- COLUMNA IZQUIERDA -->
            <!-- ====================================== -->

            <StackPanel
                Grid.Column="0"
                Margin="10,0,8,0">


                <!-- INFORMACIÓN DEL EQUIPO -->

                <Border
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,14">

                    <StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0,0,0,16">

                            <TextBlock
                                Text="ⓘ"
                                FontSize="22"
                                Foreground="#55A9FF"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="Información del equipo"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"/>

                        </StackPanel>


                        <!-- NOMBRE -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="28"/>

                                <ColumnDefinition Width="150"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="💻"
                                FontSize="17"
                                Foreground="#7892AE"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Nombre visible"
                                Style="{StaticResource FieldLabel}"
                                FontSize="12"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="2"
                                x:Name="DisplayNameInfoText"
                                Text="PC-Visual"
                                Foreground="White"
                                FontSize="12"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>

                        </Grid>


                        <Border
                            Height="1"
                            Background="#202B37"
                            Margin="0,0,0,10"/>


                        <!-- HOSTNAME -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="28"/>

                                <ColumnDefinition Width="150"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="▣"
                                FontSize="17"
                                Foreground="#7892AE"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Hostname"
                                Foreground="#93A4B8"
                                FontSize="12"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="2"
                                x:Name="HostnameText"
                                Text="Sin conexión"
                                Foreground="White"
                                FontSize="12"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>

                        </Grid>


                        <Border
                            Height="1"
                            Background="#202B37"
                            Margin="0,0,0,10"/>


                        <!-- SISTEMA -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="28"/>

                                <ColumnDefinition Width="150"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="⊞"
                                FontSize="18"
                                Foreground="#7892AE"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Sistema"
                                Foreground="#93A4B8"
                                FontSize="12"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="2"
                                x:Name="PlatformText"
                                Text="No disponible"
                                Foreground="White"
                                FontSize="12"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>

                        </Grid>


                        <Border
                            Height="1"
                            Background="#202B37"
                            Margin="0,0,0,10"/>


                        <!-- VERSION -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="28"/>

                                <ColumnDefinition Width="150"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="‹›"
                                FontSize="16"
                                Foreground="#7892AE"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Versión del agente"
                                Foreground="#93A4B8"
                                FontSize="12"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="2"
                                x:Name="VersionText"
                                Text="No disponible"
                                Foreground="White"
                                FontSize="12"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- CONEXIÓN -->

                <Border
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                    <StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0,0,0,12">

                            <TextBlock
                                Text="⌁"
                                FontSize="25"
                                Foreground="#32D583"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="Estado de conexión"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"/>

                        </StackPanel>


                        <TextBlock
                            Text="La conexión se actualiza automáticamente desde el Manager."
                            Foreground="#8FA0B3"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="0,0,0,14"/>


                        <Border
                            Height="1"
                            Background="#202B37"
                            Margin="0,0,0,12"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="28"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Text="〽"
                                FontSize="19"
                                Foreground="#55C7FF"/>

                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0">

                                <TextBlock
                                    Text="Heartbeat"
                                    Foreground="White"
                                    FontSize="12"/>

                                <TextBlock
                                    Text="Recepción de señal del agente"
                                    Foreground="#718398"
                                    FontSize="10"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                            <Ellipse
                                Grid.Column="2"
                                Width="9"
                                Height="9"
                                Fill="#32D583"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>


            <!-- ====================================== -->
            <!-- COLUMNA DERECHA -->
            <!-- ====================================== -->

            <StackPanel
                Grid.Column="1"
                Margin="8,0,10,0">


                <!-- ESTADO Y AUTORIZACIÓN -->

                <Border
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,14">

                    <StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="4,0,0,14">

                            <TextBlock
                                Text="♢"
                                FontSize="24"
                                Foreground="#55A9FF"/>

                            <TextBlock
                                Text="Estado y autorización"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"/>

                        </StackPanel>


                        <!-- ESTADO + REVOCAR -->

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border
                                Background="#153B2C"
                                BorderBrush="#1E7554"
                                BorderThickness="1"
                                CornerRadius="9"
                                Height="59"
                                Margin="0,0,5,0"
                                Padding="12">

                                <StackPanel
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="✓  Equipo autorizado"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#32D583"/>

                                    <TextBlock
                                        Text="Este equipo puede ser administrado."
                                        FontSize="9"
                                        Foreground="#86B9A3"
                                        Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>


                            <Button
                                x:Name="AuthorizationButton"
                                Grid.Column="1"
                                Content="Revocar autorización"
                                Height="59"
                                Margin="5,0,0,0"
                                Style="{StaticResource BaseButton}"
                                Foreground="#FF5A5F"
                                Background="#17151A"
                                BorderBrush="#A33B42"
                                Click="AuthorizationButton_Click"/>

                        </Grid>


                        <!-- NOMBRE -->

                        <TextBlock
                            Text="NOMBRE DEL EQUIPO"
                            Foreground="#8192A6"
                            FontSize="10"
                            Margin="0,0,0,6"/>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="105"/>

                            </Grid.ColumnDefinitions>


                            <TextBox
                                x:Name="DisplayNameTextBox"
                                Style="{StaticResource DarkTextBox}"
                                Height="42"
                                MaxLength="50"/>


                            <Button
                                x:Name="RenameButton"
                                Grid.Column="1"
                                Content="✎  Guardar"
                                Height="42"
                                Margin="10,0,0,0"
                                Style="{StaticResource BaseButton}"
                                Foreground="#55A9FF"
                                BorderBrush="#2B75B8"
                                Click="RenameButton_Click"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================== -->
                <!-- ACCIONES RÁPIDAS -->
                <!-- ================================== -->

                <Border
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,14">

                    <StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="4,0,0,12">

                            <TextBlock
                                Text="⚡"
                                FontSize="21"
                                Foreground="#FFC44D"/>

                            <TextBlock
                                Text="Acciones rápidas"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"/>

                        </StackPanel>


                        <!-- FILA 1 -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- VER PANTALLA -->

                            <Button
                                x:Name="ScreenButton"
                                Grid.Column="0"
                                Style="{StaticResource ActionButton}"
                                Background="#122A40"
                                BorderBrush="#2769A3"
                                Margin="0,0,5,0"
                                Click="ScreenButton_Click">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="58"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                                    Text="💻"
                                    Width="52"
                                    Height="52"
                                    FontSize="34"
                                    Foreground="#55A9FF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    Padding="0"/>


                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Ver pantalla"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#55A9FF"/>

                                        <TextBlock
                                            Text="Captura la pantalla del equipo"
                                            FontSize="9"
                                            Foreground="#7899B8"
                                            Margin="0,4,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Button>


                            <!-- BLOQUEAR -->

                            <Button
                                x:Name="LockSessionButton"
                                Grid.Column="1"
                                Style="{StaticResource ActionButton}"
                                Background="#302B1A"
                                BorderBrush="#806A27"
                                Margin="5,0,0,0"
                                Click="LockSessionButton_Click">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="52"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                                    
                                        Text="♙"
                                        Width="52"
                                        Height="52"
                                        FontSize="34"
                                        Foreground="#FFC44D"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Padding="0"/>


                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Bloquear sesión"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#FFC44D"/>

                                        <TextBlock
                                            Text="Bloquea la sesión de Windows"
                                            FontSize="9"
                                            Foreground="#A79A70"
                                            Margin="0,4,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Button>

                        </Grid>


                        <!-- FILA 2 -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- REINICIAR -->

                            <Button
                            Grid.Column="0"
                            Style="{StaticResource ActionButton}"
                            Background="#251A3D"
                            BorderBrush="#6843A8"
                            Margin="0,0,5,0"
                            x:Name="RestartButton"
                            Click="RestartButton_Click">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="52"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="⟳"
                                    Width="52"
                                    Height="52"
                                    FontSize="34"
                                    Foreground="#A66BFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    Padding="0"/>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="Reiniciar PC"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="#A66BFF"/>

                                    <TextBlock
                                        Text="Reinicia el equipo"
                                        FontSize="9"
                                        Foreground="#8C75AE"
                                        Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Button>


                            <!-- APAGAR -->

                            <Button
                                x:Name="ShutdownButton"
                                Grid.Column="1"
                                Style="{StaticResource ActionButton}"
                                Background="#3A1717"
                                BorderBrush="#8F3D3D"
                                Margin="5,0,0,0"
                                Click="ShutdownButton_Click">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="52"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                                        Text="⏻"
                                        Width="52"
                                        Height="52"
                                        FontSize="34"
                                        Foreground="#FF5A5F"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Padding="0"/>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Apagar PC"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#FF5A5F"/>

                                        <TextBlock
                                            Text="Apaga el equipo"
                                            FontSize="9"
                                            Foreground="#B87980"
                                            Margin="0,4,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Button>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- CERRAR -->

                <Button
                    x:Name="CloseButton"
                    Content="×   Cerrar"
                    Height="48"
                    Style="{StaticResource BaseButton}"
                    FontSize="13"
                    Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>