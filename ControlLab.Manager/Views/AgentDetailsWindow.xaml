<Window x:Class="ControlLab.Manager.Views.AgentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlLab"
        Width="500"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        ResizeMode="NoResize">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <StackPanel Grid.Row="0">

            <TextBlock
                x:Name="MachineIdText"
                Text="PC-01"
                FontSize="30"
                FontWeight="Bold"
                Foreground="White"/>

            <TextBlock
                x:Name="StatusText"
                Text="● En línea"
                FontSize="14"
                Margin="0,5,0,25"/>

        </StackPanel>

        <!-- CONTENIDO -->

        <StackPanel
            Grid.Row="1">

            <TextBlock
                Text="NOMBRE DEL EQUIPO"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,4"/>

            <TextBlock
                x:Name="HostnameText"
                FontSize="14"
                Foreground="White"
                Margin="0,0,0,15"/>


            <TextBlock
                Text="SISTEMA"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,4"/>

            <TextBlock
                x:Name="PlatformText"
                FontSize="14"
                Foreground="White"
                Margin="0,0,0,15"/>


            <TextBlock
                Text="VERSIÓN DEL AGENTE"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,4"/>

            <TextBlock
                x:Name="VersionText"
                FontSize="14"
                Foreground="White"
                Margin="0,0,0,15"/>


            <TextBlock
                Text="ÚLTIMO HEARTBEAT"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,4"/>

            <TextBlock
                x:Name="HeartbeatText"
                FontSize="14"
                Foreground="White"
                Margin="0,0,0,15"/>


            <Border
                Height="1"
                Background="#292E39"
                Margin="0,20,0,20"/>


            <!-- VER PANTALLA -->

            <Button
                x:Name="ScreenButton"
                Content="Ver pantalla"
                Height="45"
                FontSize="14"
                Margin="0,0,0,10"
                Click="ScreenButton_Click"/>


            <!-- CERRAR -->

            <Button
                Content="Cerrar"
                Height="40"
                FontSize="13"
                Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>

</Window>