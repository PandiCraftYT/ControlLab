<Window x:Class="ControlLab.Manager.Views.AgentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlLab"
        Width="500"
        Height="730"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        ResizeMode="NoResize">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <StackPanel Grid.Row="0">

            <TextBlock
                x:Name="MachineIdText"
                Text="PC-01"
                FontSize="30"
                FontWeight="Bold"
                Foreground="White"/>

            <TextBlock
                x:Name="StatusText"
                Text="● En línea"
                FontSize="14"
                Margin="0,5,0,10"/>

            <!-- ESTADO DE AUTORIZACIÓN -->

            <Border
                x:Name="AuthorizationBadge"
                Background="#1F252F"
                CornerRadius="8"
                Padding="10,7"
                HorizontalAlignment="Left"
                Margin="0,0,0,25">

                <TextBlock
                    x:Name="AuthorizationText"
                    Text="⚠ Pendiente de autorización"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FFB446"/>

            </Border>

        </StackPanel>

        <!-- CONTENIDO -->

        <StackPanel
            Grid.Row="1">

            <!-- NOMBRE VISIBLE -->

            <TextBlock
                Text="NOMBRE DEL EQUIPO"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="DisplayNameTextBox"
                    Height="38"
                    FontSize="14"
                    Padding="10,6"
                    Background="#171A21"
                    Foreground="White"
                    BorderBrush="#292E39"
                    MaxLength="50"
                    VerticalContentAlignment="Center"/>

                <Button
                x:Name="RenameButton"
                Grid.Column="1"
                Content="Cambiar"
                Height="38"
                Margin="10,0,0,0"
                FontSize="13"
                Click="RenameButton_Click"/>

            </Grid>


            <!-- HOSTNAME -->

            <TextBlock
                Text="HOSTNAME"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,4"/>

            <TextBlock
                x:Name="HostnameText"
                FontSize="14"
                Foreground="White"
                Margin="0,0,0,15"/>


            <!-- SISTEMA -->

            <TextBlock
                Text="SISTEMA"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,4"/>

            <TextBlock
                x:Name="PlatformText"
                FontSize="14"
                Foreground="White"
                Margin="0,0,0,15"/>


            <!-- VERSIÓN -->

            <TextBlock
                Text="VERSIÓN DEL AGENTE"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,4"/>

            <TextBlock
                x:Name="VersionText"
                FontSize="14"
                Foreground="White"
                Margin="0,0,0,15"/>


            <!-- HEARTBEAT -->

            <TextBlock
                Text="ÚLTIMO HEARTBEAT"
                FontSize="10"
                Foreground="#8B93A1"
                Margin="0,0,0,4"/>

            <TextBlock
                x:Name="HeartbeatText"
                FontSize="14"
                Foreground="White"
                Margin="0,0,0,15"/>


            <Border
                Height="1"
                Background="#292E39"
                Margin="0,10,0,20"/>


            <!-- AUTORIZACIÓN -->

            <Button
                x:Name="AuthorizationButton"
                Content="Autorizar equipo"
                Height="45"
                FontSize="14"
                Margin="0,0,0,10"
                Click="AuthorizationButton_Click"/>


            <!-- VER PANTALLA -->

            <Button
                x:Name="ScreenButton"
                Content="Ver pantalla"
                Height="45"
                FontSize="14"
                Margin="0,0,0,10"
                Click="ScreenButton_Click"/>


            <!-- CERRAR -->

            <Button
                Content="Cerrar"
                Height="40"
                FontSize="13"
                Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>

</Window>