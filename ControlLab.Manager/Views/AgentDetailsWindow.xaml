<Window x:Class="ControlLab.Manager.Views.AgentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/ControlLab.Manager;component/Assets/ControlLab.ico"
        Title="ControlLab · Equipo"
        Width="1100"
        Height="760"
        MinWidth="950"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C10"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <!-- ================================================= -->
        <!-- COLORES -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#0A0C10"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#10151D"/>

        <SolidColorBrush x:Key="PanelBorderBrush"
                         Color="#202B37"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#55A9FF"/>

        <SolidColorBrush x:Key="TextPrimaryBrush"
                         Color="#F4F7FB"/>

        <SolidColorBrush x:Key="TextSecondaryBrush"
                         Color="#93A4B8"/>

        <SolidColorBrush x:Key="TextMutedBrush"
                         Color="#66778A"/>

        <!-- ================================================= -->
        <!-- BOTÓN BASE -->
        <!-- ================================================= -->

        <Style x:Key="ControlButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Foreground"
                    Value="#EAF0F7"/>

            <Setter Property="Background"
                    Value="#151C25"/>

            <Setter Property="BorderBrush"
                    Value="#2A3948"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#1C2733"/>

                    <Setter Property="BorderBrush"
                            Value="#3A536A"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#253443"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.35"/>

                    <Setter Property="Cursor"
                            Value="Arrow"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    <Style
        x:Key="AuthorizationButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource ControlButton}">

        <Setter
            Property="Background"
            Value="#16352B"/>

        <Setter
            Property="BorderBrush"
            Value="#267A5A"/>

        <Setter
            Property="Foreground"
            Value="#32D583"/>

    </Style>

        <!-- ================================================= -->
        <!-- BOTÓN ELIMINAR -->
        <!-- ================================================= -->

        <Style x:Key="DeleteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ControlButton}">

            <Setter Property="Background"
                    Value="#35191B"/>

            <Setter Property="BorderBrush"
                    Value="#8F3D3D"/>

            <Setter Property="Foreground"
                    Value="#FF7070"/>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN CONTROL REMOTO -->
        <!-- ================================================= -->

        <Style x:Key="RemoteControlButton"
               TargetType="Button"
               BasedOn="{StaticResource ControlButton}">

            <Setter Property="Background"
                    Value="#122A40"/>

            <Setter Property="BorderBrush"
                    Value="#2769A3"/>

            <Setter Property="Foreground"
                    Value="#55A9FF"/>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN TECLADO -->
        <!-- ================================================= -->

        <Style x:Key="KeyboardButton"
               TargetType="Button"
               BasedOn="{StaticResource ControlButton}">

            <Setter Property="Background"
                    Value="#191C32"/>

            <Setter Property="BorderBrush"
                    Value="#474C8A"/>

            <Setter Property="Foreground"
                    Value="#9B9FFF"/>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN BLOQUEAR -->
        <!-- ================================================= -->

        <Style x:Key="LockButton"
               TargetType="Button"
               BasedOn="{StaticResource ControlButton}">

            <Setter Property="Background"
                    Value="#302B1A"/>

            <Setter Property="BorderBrush"
                    Value="#806A27"/>

            <Setter Property="Foreground"
                    Value="#FFC44D"/>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN REINICIAR -->
        <!-- ================================================= -->

        <Style x:Key="RestartButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ControlButton}">

            <Setter Property="Background"
                    Value="#251A3D"/>

            <Setter Property="BorderBrush"
                    Value="#6843A8"/>

            <Setter Property="Foreground"
                    Value="#A66BFF"/>

        </Style>

        <!-- ================================================= -->
        <!-- BOTÓN APAGAR -->
        <!-- ================================================= -->

        <Style x:Key="ShutdownButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ControlButton}">

            <Setter Property="Background"
                    Value="#3A1717"/>

            <Setter Property="BorderBrush"
                    Value="#8F3D3D"/>

            <Setter Property="Foreground"
                    Value="#FF5A5F"/>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ===================================================== -->

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="4,0,4,16">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- ICONO -->

            <Border
                Width="58"
                Height="58"
                Background="#132131"
                BorderBrush="#233B50"
                BorderThickness="1"
                CornerRadius="13">

                <Image
                Width="32"
                Height="32"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="/ControlLab.Manager;component/Assets/ControlLab.ico"/>

            </Border>


            <!-- NOMBRE -->

            <StackPanel
                Grid.Column="1"
                Margin="15,0,0,0"
                VerticalAlignment="Center">

                <TextBlock
                    x:Name="MachineIdText"
                    Text="PC-Visual"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis"/>

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,5,0,0">

                    <TextBlock
                        x:Name="HostnameText"
                        Text="DESKTOP-6PORHOBQ"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"/>

                    <TextBlock
                        Text="  •  "
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"/>

                    <TextBlock
                        x:Name="StatusText"
                        Text="● EN LÍNEA"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#32D583"/>

                </StackPanel>

            </StackPanel>


            <!-- ESTADO -->

            <Border
                Grid.Column="2"
                Background="#10271E"
                BorderBrush="#1B5B42"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14,8"
                VerticalAlignment="Center">

                <StackPanel
                    Orientation="Horizontal">

                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="#32D583"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="  CONECTADO"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#32D583"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- CONTENIDO -->
        <!-- ================================================= -->

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- PANTALLA -->
            <!-- ================================================= -->

            <Border
                Grid.Row="0"
                Background="#05070A"
                BorderBrush="#202B37"
                BorderThickness="1"
                CornerRadius="12"
                Padding="1"
                ClipToBounds="True">

                <Grid>

                    <!-- PANTALLA -->

                    <Image
                        x:Name="RemoteImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- ================================================= -->
                    <!-- SUPERFICIE DE CONTROL DEL MOUSE -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="RemoteInputOverlay"
                        Background="#01000000"
                        Visibility="Collapsed"
                        Cursor="Arrow"
                        MouseMove="RemoteInputOverlay_MouseMove"
                        MouseLeftButtonDown="RemoteInputOverlay_MouseLeftButtonDown"
                        MouseLeftButtonUp="RemoteInputOverlay_MouseLeftButtonUp"
                        MouseRightButtonDown="RemoteInputOverlay_MouseRightButtonDown"
                        MouseRightButtonUp="RemoteInputOverlay_MouseRightButtonUp"
                        MouseDown="RemoteInputOverlay_MouseDown"
                        MouseUp="RemoteInputOverlay_MouseUp"
                        MouseWheel="RemoteInputOverlay_MouseWheel"/>

                    <!-- ================================================= -->
                    <!-- INDICADOR CONTROL REMOTO ACTIVO -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="RemoteControlActiveBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="14"
                        Background="#102A1D"
                        BorderBrush="#32D583"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,6"
                        Visibility="Collapsed">

                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#32D583"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="  CONTROL ACTIVO"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#32D583"/>
                        </StackPanel>
                    </Border>


                    <!-- MENSAJE SIN CONEXIÓN -->

                    <StackPanel
                        x:Name="NoConnectionPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">

                        <TextBlock
                            Text="▣"
                            FontSize="44"
                            Foreground="#33404D"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Sin conexión"
                            FontSize="14"
                            Foreground="#718398"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"/>

                    </StackPanel>


                    <!-- INDICADOR EN VIVO -->

                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="14"
                        Background="#0E1F18"
                        BorderBrush="#205F45"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,6">

                        <StackPanel
                            Orientation="Horizontal">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#32D583"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="StreamStatusText"
                                Text="  EN VIVO"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#32D583"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- ESTADO DEL STREAM -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Margin="4,10,4,10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel
                    Orientation="Horizontal">

                    <Ellipse
                        Width="7"
                        Height="7"
                        Fill="#32D583"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="  EN VIVO"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#32D583"/>

                </StackPanel>


                <TextBlock
                    Grid.Column="1"
                    x:Name="ResolutionText"
                    Text="640 × 360"
                    FontSize="10"
                    Foreground="#718398"
                    Margin="20,0,20,0"/>


                <TextBlock
                    Grid.Column="2"
                    x:Name="FpsText"
                    Text="10 FPS"
                    FontSize="10"
                    Foreground="#718398"/>

            </Grid>


            <!-- ================================================= -->
            <!-- CONTROLES -->
            <!-- ================================================= -->

            <Border
                Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,12">

                <StackPanel>


                    <!-- TÍTULO -->

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="2,0,0,12">

                        <TextBlock
                            Text="⚙"
                            FontSize="17"
                            Foreground="#55A9FF"/>

                        <TextBlock
                            Text="  CONTROL Y ACCIONES"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#EAF0F7"
                            VerticalAlignment="Center"/>

                    </StackPanel>


                    <!-- BOTONES -->

                    <WrapPanel
                        HorizontalAlignment="Left">


                        <!-- CONTROL REMOTO -->

                        <Button
                            x:Name="RemoteControlButton"
                            Content="🖱  Control remoto"
                            Width="150"
                            Margin="0,0,8,0"
                            Style="{StaticResource RemoteControlButton}"
                            Click="RemoteControlButton_Click"/>


                        <!-- TECLADO -->

                        <Button
                            x:Name="KeyboardButton"
                            Content="⌨  Teclado"
                            Width="125"
                            Margin="0,0,8,0"
                            Style="{StaticResource KeyboardButton}"
                            Click="KeyboardButton_Click"/>


                        <!-- BLOQUEAR -->

                        <Button
                            x:Name="LockSessionButton"
                            Content="🔒  Bloquear"
                            Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource LockButton}"
                            Click="LockSessionButton_Click"/>


                        <!-- REINICIAR -->

                        <Button
                            x:Name="RestartButton"
                            Content="↻  Reiniciar"
                            Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource RestartButtonStyle}"
                            Click="RestartButton_Click"/>


                        <!-- APAGAR -->

                        <Button
                            x:Name="ShutdownButton"
                            Content="⏻  Apagar"
                            Width="110"
                            Style="{StaticResource ShutdownButtonStyle}"
                            Click="ShutdownButton_Click"/>

                        <Button
                            x:Name="AuthorizationButton"
                            Content="🛡  Autorizar"
                            Width="125"
                            Margin="8,0,0,0"
                            Style="{StaticResource AuthorizationButtonStyle}"
                            Click="AuthorizationButton_Click"/>

                        <!-- ELIMINAR EQUIPO -->

                        <Button
                            x:Name="DeleteAgentButton"
                            Content="🗑  Eliminar"
                            Width="120"
                            Margin="8,0,0,0"
                            Style="{StaticResource DeleteButtonStyle}"
                            Click="DeleteAgentButton_Click"/>

                    </WrapPanel>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="2"
            Margin="4,2,4,0">

            <TextBlock
                Text="ControlLab  •  Administración del laboratorio"
                FontSize="10"
                Foreground="#536477"
                VerticalAlignment="Center"/>

            <Button
                x:Name="CloseButton"
                Content="✕  Cerrar"
                Width="100"
                Height="38"
                HorizontalAlignment="Right"
                Style="{StaticResource ControlButton}"
                Click="CloseButton_Click"/>

        </Grid>

    </Grid>

</Window>